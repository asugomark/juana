# Copy to .env and fill in real values. Never commit .env.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# MySQL — create the database first: CREATE DATABASE juana;
DATABASE_URL=mysql+pymysql://juana_user:password@localhost:3306/juana

# SasaPay — from the SasaPay Developer Portal (sandbox app first).
# These are only a BOOTSTRAP fallback — once you save credentials via
# Admin -> Finance -> Settings in the app itself, those (encrypted, in the
# database) take over and these can be left blank. Useful for first-time
# setup before you have an admin account yet.
SASAPAY_BASE_URL=https://sandbox.sasapay.app
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=
# Must be a publicly reachable URL for SasaPay's IPN callbacks — use ngrok in dev,
# your real domain in prod. e.g. https://your-ngrok-subdomain.ngrok.io
PUBLIC_CALLBACK_BASE_URL=http://localhost:5000

# Required before saving ANY credentials via the admin Settings tab — this key
# encrypts them at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every stored credential becomes unreadable — back it
# up somewhere real, not just this file.
SETTINGS_ENCRYPTION_KEY=

# Cloudinary — required for photo/video uploads to survive a Render/Heroku-style
# redeploy (local disk is wiped every deploy there) and to work across multiple
# instances. Leave all three blank for local dev if you don't want a Cloudinary
# account yet — uploads fall back to local disk automatically. Get these from
# your Cloudinary dashboard (Settings -> API Keys) after creating a free account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# KYC vendor (Persona / Veriff / Stripe Identity) — wire in routes/verification.py
KYC_API_KEY=

CORS_ORIGIN=http://localhost:5173
