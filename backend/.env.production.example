# ==============================================================
# Juana Backend Production Environment Configuration
# Copy this file to backend/.env and fill in real production values.
# NEVER commit the filled .env file to Git!
# ==============================================================

FLASK_ENV=production
FLASK_DEBUG=0

# Security Keys — Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_char_hex_secret_here
JWT_SECRET_KEY=generate_another_random_64_char_hex_secret_here

# Settings Encryption Key (Fernet) — Required for encrypted admin credentials at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=generate_fernet_key_here

# Database URL
# When using docker-compose.yml with the included 'db' service:
DATABASE_URL=mysql+pymysql://juana_user:change_me_to_a_strong_password@db:3306/juana
# If using a MySQL instance installed natively on the VPS host instead of Docker:
# DATABASE_URL=mysql+pymysql://juana_user:password@host.docker.internal:3306/juana

# Optional Redis URL (for scaling SocketIO across multiple workers and caching)
REDIS_URL=redis://redis:6379/0

# Public domain where the frontend is hosted (comma-separated if multiple domains)
CORS_ORIGIN=https://yourdomain.com

# SasaPay API Configuration (Live Production or Sandbox)
SASAPAY_BASE_URL=https://api.sasapay.app
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=

# Public callback base URL that SasaPay can reach over the internet to deliver IPN webhooks:
# e.g. https://yourdomain.com or https://api.yourdomain.com
PUBLIC_CALLBACK_BASE_URL=https://yourdomain.com

# Cloudinary (Optional - leave blank if using persistent local storage volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# KYC Vendor API Key (e.g., Persona / Veriff / Stripe Identity)
KYC_API_KEY=

# Gunicorn configuration in container
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
