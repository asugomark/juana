# Juana Frontend Production Environment Configuration
# Copy this to .env.production before running `npm run build`

# When deployed behind Nginx reverse proxy on the same domain (RECOMMENDED):
# Leaving this as /api routes calls to the same host, avoiding cross-origin issues and extra SSL certs.
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

# If backend is on a completely separate domain or subdomain:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
